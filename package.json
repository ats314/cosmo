{
  "name": "cosmo",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "description": "Cosmo: a portrait arcade game for the web, iOS and Android.",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host localhost",
    "typecheck": "tsc --noEmit",
    "test": "node tools/all.mjs",
    "test:fast": "node tools/all.mjs --fast",
    "native:sync": "npm run build && cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.1",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.1",
    "@netlify/blobs": "^8.1.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@types/node": "24.13.3",
    "playwright": "1.56.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
